# ============================================
# 项目中心服务 - 环境变量配置模板
# 复制本文件为 .env 并修改对应值
# .env 已被 .gitignore 忽略，不会提交到仓库
# ============================================

# 服务端口与监听地址
PORT=3000
# 监听 0.0.0.0 才能被 Nginx / 外部访问
HOST=0.0.0.0

# 运行环境：development / production
NODE_ENV=production

# 日志级别：DEBUG / INFO / WARN / ERROR
LOG_LEVEL=INFO

# ============================================
# 对外访问地址（部署到公网必须设置）
# 二维码内容基于此地址生成，若填内网地址手机扫码将无法访问
# 有域名：https://your-domain.com
# 只有 IP：http://206.187.214.190
# ============================================
PUBLIC_BASE_URL=https://lizyi.asia

# 反向代理信任层数（Nginx 在本机填 1；直接对外暴露填 false）
TRUST_PROXY=1

# ============================================
# HTTPS 相关（两个开关语义不同，别混用）
# ============================================
# FORCE_HTTPS：应用层是否主动把 http 跳转到 https
#   true  = Node 自己 301 跳 https（应用直接对外的场景）
#   false = 由 Nginx 负责跳转（推荐的部署方式，避免双层跳转）
FORCE_HTTPS=false

# COOKIE_SECURE：Cookie 是否只允许在 https 下发送
#   优先级：COOKIE_SECURE > PUBLIC_BASE_URL 协议 > NODE_ENV
#   HTTPS 站点必须为 true，否则 Cookie 会随 http 请求明文传输
#   纯 HTTP 部署（无证书）必须为 false，否则浏览器直接丢弃 Cookie
COOKIE_SECURE=true

# ============================================
# MySQL 数据库配置
# 应用与 MySQL 同机时用 127.0.0.1
# ============================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=myself_blog2

# ============================================
# 内置管理员账号（首次启动自动创建）
# 部署前务必改成强密码，创建后再改需要手动更新数据库
# ============================================
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_STRONG

# ============================================
# 免密直登 IP 白名单（全站唯一需要 IP 限制的入口）
#
# 该接口不需要任何凭据就能签发登录态，公网可达 = 谁都能进。
# 所以必须写死来源 IP，只有你自己的出口 IP 才放行。
#
# 支持单个 IP 与 CIDR 网段，逗号分隔
# 示例：127.0.0.1,::1,192.168.1.0/24,223.90.17.124
# 家宽公网 IP 会变动，变动后登录返回 403 就更新这里再重启
#
# 留空时由 DIRECT_LOGIN_IPS_ALLOW_EMPTY 决定：
#   false（推荐）= 留空即拒绝，任何人都进不去
#   true         = 留空即放开，公网部署切勿使用
# ============================================
DIRECT_LOGIN_IPS=127.0.0.1,::1
DIRECT_LOGIN_IPS_ALLOW_EMPTY=false

# ============================================
# 注册开关（不再使用 IP 白名单）
#
# 注册接口是公开的，任何来源都能注册，防滥用靠：
#   1. 用户名/密码格式校验（core/security.js）
#   2. CSRF double-submit 校验
#   3. 全局频率限制（RATE_LIMIT_MAX）
#
# ALLOW_REGISTER=false 可临时整站关闭注册（返回 403）
# 留空或 true = 允许注册
# ============================================
ALLOW_REGISTER=true

# ============================================
# 频率限制
# ============================================
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# ============================================
# 会话配置
# ============================================
# 二维码有效期（毫秒）
QR_EXPIRE_MS=120000
# Web 登录态有效期（毫秒，默认 7 天）
WEB_TOKEN_EXPIRE_MS=604800000

# ============================================
# ChatRecord OCR 服务
# AUTO_START_OCR=true 时由 Node 拉起 Python OCR 进程
# 服务器未装 RapidOCR 依赖时保持 false
# ============================================
OCR_PORT=8765
AUTO_START_OCR=false

# ============================================
# 注册验证码（8-01）
# 留空时进程启动随机生成，单实例部署完全够用；多实例/多副本部署时
# 必须给每个实例配同一个值，否则验证码在实例间无法互认。
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ============================================
CAPTCHA_SECRET=

# ============================================
# blog-sentinel 访问审计（可选，零侵入）
# 开启后：谁登录过博客、谁访问了哪个 IP / 网址，会实时上报到独立审计后台。
# 部署监控服务后，把其 .env 里的 INGEST_KEY 原样填到下方即可。
# 留空 = 完全禁用，对博客零影响。
# ============================================
INGEST_KEY=
# 监控服务地址（同机部署默认即可；若监控服务在别的机器/端口请修改）
SENTINEL_BASE_URL=http://127.0.0.1:3100
# 是否上报每个请求的访问日志
SENTINEL_LOG_ACCESS=true
# 是否排除静态资源（.css/.js/.png 等）
SENTINEL_EXCLUDE_STATIC=false
