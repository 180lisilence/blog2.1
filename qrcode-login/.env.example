# ============================================
# 项目中心服务 - 环境变量配置模板
# 复制本文件为 .env 并修改对应值
# .env 已被 .gitignore 忽略，不会提交到仓库
# ============================================

# 服务端口与监听地址
PORT=3000
# 监听 0.0.0.0 才能被 Nginx / 外部访问
HOST=0.0.0.0

# 运行环境：development / production
# production 会启用 HTTPS 强制跳转、Cookie Secure 标记
NODE_ENV=production

# 日志级别：DEBUG / INFO / WARN / ERROR
LOG_LEVEL=INFO

# ============================================
# 对外访问地址（部署到公网必须设置）
# 二维码内容基于此地址生成，若填内网地址手机扫码将无法访问
# 有域名：https://your-domain.com
# 只有 IP：http://206.187.214.190
# ============================================
PUBLIC_BASE_URL=http://206.187.214.190

# 反向代理信任层数（Nginx 在本机填 1；直接对外暴露填 false）
TRUST_PROXY=1

# ============================================
# MySQL 数据库配置
# 应用与 MySQL 同机时用 127.0.0.1
# ============================================
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=CHANGE_ME
MYSQL_DATABASE=myself_blog2

# ============================================
# 内置管理员账号（首次启动自动创建）
# 部署前务必改成强密码，创建后再改需要手动更新数据库
# ============================================
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_STRONG

# ============================================
# 免密直登 IP 白名单（安全关键项）
# 只有列表内的来源 IP 才能调用 /api/direct-login 一键进入
# 支持单个 IP 与 CIDR 网段，逗号分隔
# 示例：127.0.0.1,::1,192.168.1.0/24
# 留空时由 DIRECT_LOGIN_IPS_ALLOW_EMPTY 决定：
#   false（推荐）= 留空即拒绝，任何人都进不去
#   true         = 留空即放开，公网部署切勿使用
# ============================================
DIRECT_LOGIN_IPS=127.0.0.1,::1
DIRECT_LOGIN_IPS_ALLOW_EMPTY=true

# ============================================
# 注册接口 IP 白名单
# 生产环境建议留空（即关闭公开注册），需要加账号时临时开启
# REGISTER_IPS_ALLOW_EMPTY=true 表示留空时仍允许注册
# ============================================
REGISTER_IPS=
REGISTER_IPS_ALLOW_EMPTY=false

# ============================================
# 频率限制
# ============================================
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW_MS=60000

# ============================================
# 会话配置
# ============================================
# 二维码有效期（毫秒）
QR_EXPIRE_MS=120000
# Web 登录态有效期（毫秒，默认 7 天）
WEB_TOKEN_EXPIRE_MS=604800000

# ============================================
# ChatRecord OCR 服务
# AUTO_START_OCR=true 时由 Node 拉起 Python OCR 进程
# 服务器未装 RapidOCR 依赖时保持 false
# ============================================
OCR_PORT=8765
AUTO_START_OCR=false
